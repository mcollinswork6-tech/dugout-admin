rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NNLL Dugout Admin: Allow coaches to read and write teams, rosters, and stats
    match /teams/{teamId} {
      allow read, write: if true;
    }
    
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
